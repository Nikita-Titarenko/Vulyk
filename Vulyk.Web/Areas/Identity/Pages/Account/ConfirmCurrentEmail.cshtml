@page
@model ConfirmCurrentEmailModel
@{
	Layout = "~/Views/Shared/AppLayout.cshtml";
	ViewData["Title"] = "Confirm current email";
}
@section Styles{
	<link rel="stylesheet" href="/css/form.css" />
}
<h2>Enter new email.</h2>
<div class="form-container">
	<div class="form">
		<form method="post">
			<input type="hidden" asp-for="@Model.UserId" />
			<input type="hidden" asp-for="@Model.Code" />
			<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
			<div class="form-floating mb-3 w-100">
				<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
				<label asp-for="Input.Email" class="form-label"></label>
				<span asp-validation-for="Input.Email" class="text-danger"></span>
			</div>
			<button type="submit" class="w-100 btn btn-primary">Send verification link</button>
		</form>
	</div>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
