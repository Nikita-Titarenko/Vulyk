@page
@model NewEmailConfirmationModel
@{
	Layout = "~/Views/Shared/AppLayout.cshtml";
	ViewData["Title"] = "New email confirmation";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h1>@ViewData["Title"]</h1>

<div class="form">
	<p class="w-100 text-center">
		Please check @Model.Email to confirm your account.
	</p>

	<a class="w-100 text-center" asp-page="/Account/ConfirmCurrentEmail" asp-route-code="@Model.Code" asp-route-userId="@Model.UserId">Input wrong email?</a>
	<form class="w-100 text-center" method="post">
		<input type="hidden" asp-for="Email" />
		<button type="submit" class="link">Resent email</button>
	</form>
</div>