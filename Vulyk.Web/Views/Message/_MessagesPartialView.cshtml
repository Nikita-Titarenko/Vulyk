@using Vulyk.Web.ViewModels.Message
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken"/>
@model Vulyk.Web.ViewModels.Message.MessageListViewModel
<div class="d-flex justify-content-between" id="chat-header">
	<div class="subheading">@Model.FullName</div>
	<i class="fa fa-ellipsis-v fa-2x i-chat-tool"></i>
</div>
<div class="message-container mt-auto h-100" data-user-id="@Model.PartnerId">
	@foreach (MessageListItemViewModel messageListItemViewModel in Model.Messages)
	{
		string messageTypeClass = messageListItemViewModel.IsMine ? "your" : "partner";
		<div class="message @messageTypeClass">
			<div class="message-text">@messageListItemViewModel.Text</div>
			<div class="message-time @messageTypeClass">@messageListItemViewModel.CreationDateTime.ToString("HH:mm")</div>
		</div>
	}

</div>
<div id="chatId" data-chat-id="@Model.ChatId" hidden></div>
<form id="createMessageForm" class="d-flex write-message-form">
	<input asp-for="PartnerId" hidden />
	<textarea class="form-input w-100" name="text" placeholder="Write a message"></textarea>
	<button type="submit"><i class="fa fa-paper-plane fa-2x i-chat-tool p-3"></i></button>
</form>