@page
@model ResetPasswordModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Reset password";
}
<div class="form">
	<form method="post">
		<h5 class="subheading text-center mb-3">Reset your password</h5>
		<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
		<input asp-for="Input.Code" type="hidden" />
		<input asp-for="UserId" type="hidden" />
		<div class="form-floating mb-3 w-100">
			<input asp-for="Input.Password" class="form-control password-input" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
			<label asp-for="Input.Password" class="form-label"></label>
			<span asp-validation-for="Input.Password" class="text-danger"></span>
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<div class="form-floating mb-3 w-100">
			<input asp-for="Input.ConfirmPassword" class="form-control password-input" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
			<label asp-for="Input.ConfirmPassword" class="form-label"></label>
			<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<button type="submit" class="w-100 btn btn-primary">Reset</button>
	</form>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
