@page
@model ForgotPasswordConfirmation
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Forgot password confirmation";
}

<h1>@ViewData["Title"]</h1>
<div class="form">
	<p class="w-100 text-center">
		Please check @Model.Email to reset your password.
	</p>
	<a class="w-100 text-center" asp-page="/Account/ForgotPassword">Input wrong email?</a>
	<form class="w-100 text-center" method="post">
		<input type="hidden" asp-for="Email" />
		<button type="submit" class="link">Resent email</button>
	</form>
</div>