@page
@model RegisterModel
@{
	Layout = "~/Areas/Identity/Pages/Account/AuthLayout.cshtml";
	ViewData["Title"] = "Register";
}

<h5 class="subheading bold-text">Welcome to Vulyk</h5>

<div class="form">
	<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
		<h6 class="subtitle text-center">Create an account</h6>
		<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
		<div class="form-floating mb-3 w-100">
			<input asp-for="Input.FullName" class="form-control" autocomplete="username" aria-required="true" placeholder="full name" />
			<label asp-for="Input.FullName"></label>
			<span asp-validation-for="Input.FullName" class="text-danger"></span>
		</div>
		<div class="form-floating mb-3 w-100">
			<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
			<label asp-for="Input.Email">Email</label>
			<span asp-validation-for="Input.Email" class="text-danger"></span>
		</div>
		<div class="form-floating mb-3 w-100">
			<input asp-for="Input.Password" class="form-control password-input" autocomplete="new-password" aria-required="true" placeholder="password" />
			<label asp-for="Input.Password"></label>
			<span asp-validation-for="Input.Password" class="text-danger"></span>
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<div class="form-floating mb-3 w-100">
			<input asp-for="Input.ConfirmPassword" class="form-control password-input" autocomplete="new-password" aria-required="true" placeholder="password" />
			<label asp-for="Input.ConfirmPassword"></label>
			<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<button id="registerSubmit" type="submit" class="w-100 btn btn-primary">Register</button>
		<div>
			<p class="w-100 d-flex justify-content-center gap-2">
				<span>Have already an account?</span>
				<a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
			</p>
		</div>
	</form>
</div>
<section>
	<div>
		<p>
			@foreach (var provider in Model.ExternalLogins!)
			{
				<a asp-page="/Account/ExternalLogin" class="google-button" name="provider" asp-route-provider="@provider.Name" title="Log in using your @provider.DisplayName account" asp-route-returnUrl="@Model.ReturnUrl">
					<img src="~/images/google-icon.webp" width="30" height="30" />
					@provider.DisplayName
				</a>
			}
		</p>
	</div>
</section>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
