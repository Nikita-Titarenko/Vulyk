@model Vulyk.ViewModels.EditPasswordViewModel
@{
	Layout = "~/Views/Shared/AppLayout.cshtml";
	ViewData["Title"] = "Edit password";
}
@section Styles{
	<link rel="stylesheet" href="~/css/form.css" />
}
@{
	<form class="form" asp-action="@nameof(ProfileController.EditPassword)" asp-controller="Profile">
		<h6 class="subtitle bold-text left-text">Edit password</h6>
		<label class="@(ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="CurrentPassword"></label>
		<div class="input-wrapper">
			<input class="form-input password-input w-100 @(ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="CurrentPassword" placeholder="@Html.DisplayNameFor(m => m.CurrentPassword)" />
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<span class="invalid-validation-message" asp-validation-for="CurrentPassword"></span>
		<label class="@(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="NewPassword"></label>
		<div class="input-wrapper">
			<input class="form-input password-input w-100 @(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="NewPassword" placeholder="@Html.DisplayNameFor(m => m.NewPassword)" />
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<span class="invalid-validation-message" asp-validation-for="NewPassword"></span>
		<label class="@(ViewData.ModelState["NewPasswordConfirm"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="NewPasswordConfirm"></label>
		<div class="input-wrapper">
			<input class="form-input password-input w-100 @(ViewData.ModelState["NewPasswordConfirm"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="NewPasswordConfirm" placeholder="@Html.DisplayNameFor(m => m.NewPasswordConfirm)" />
			<button class="btn-show-password input-right-element" type="button">
				<i class="fa fa-eye-slash eye-icon"></i>
			</button>
		</div>
		<span class="invalid-validation-message" asp-validation-for="NewPasswordConfirm"></span>
		<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
		<input class="btn btn-primary" type="submit" value="Save" />
		@{
			if (ViewBag.SuccessMessage != null)
			{
				<span class="mx-auto bold-text subtitle">@ViewBag.SuccessMessage</span>
			}
		}
	</form>
}
@section Scripts {
	<script src="~/js/form.js"></script>
}