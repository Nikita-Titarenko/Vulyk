@model EditProfileViewModel
@{
	Layout = "~/Views/Shared/AppLayout.cshtml";
	ViewData["Title"] = "Edit profile";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<div class="form-container">
	<h5 class="subheading bold-text">Edit profile</h5>
	<form class="form" asp-controller="Profile" asp-action="@nameof(ProfileController.EditProfile)">
		<input type="hidden" asp-for="IsPasswordExist"/>
		<h6 class="subtitle bold-text">Profile</h6>
		<label class="@(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="FullName"></label>
		<input class="form-input @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="FullName" placeholder="@Html.DisplayNameFor(m => m.FullName)" />
		<span class="invalid-validation-message" asp-validation-for="FullName"></span>
		<label class="@(ViewData.ModelState["Phone"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="Phone"></label>
		<input class="form-input @(ViewData.ModelState["Phone"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="Phone" placeholder="@Html.DisplayNameFor(m => m.Phone)" />
		<span class="invalid-validation-message" asp-validation-for="Phone"></span>
		<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
		<input class="btn btn-primary" type="submit" value="Save" />
		@{
			if (ViewBag.SuccessMessage != null)
			{
				<span class="mx-auto bold-text subtitle">@ViewBag.SuccessMessage</span>
			}
		}

		<h6 class="subtitle bold-text left-text">Account security</h6>
		<label>Password</label>
		<div class="input-wrapper">
			<input class="form-input w-100" value="@(Model.IsPasswordExist ? "••••••" : "")" readonly type="text"/>
			<a class="input-right-element" asp-action="@(Model.IsPasswordExist ? nameof(ProfileController.EditPassword) : nameof(ProfileController.AddPassword))" asp-controller="Profile">
				<p class="right-button-text right-text">@(Model.IsPasswordExist ? "Edit password" : "Add password")</p>
			</a>
		</div>
		<label class="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="Email"></label>
		<div class="input-wrapper">
			<input class="form-input w-100 @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="Email" placeholder="@Html.DisplayNameFor(m => m.Email)" readonly/>
			<a class="input-right-element right-text" asp-action="@nameof(ProfileController.EditEmail)" asp-controller="Profile" asp-route-email="@Model.Email">
				<p class="right-button-text right-text">Edit email</p>
			</a>
		</div>
	</form>
</div>
@section Scripts {
	<script src="~/js/form.js"></script>
}