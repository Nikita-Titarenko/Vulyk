@model EmailConfirmViewModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Add new email";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h5 class="subheading bold-text">Add new email</h5>
<h6 class="subtitle w-75 text-center">Enter a new email and we will send you a verification code</h6>
<form class="form" asp-controller="Profile" asp-action="@nameof(ProfileController.NewEmailInput)">
	<input asp-for="VerificationToken" type="hidden"/>
	<label class="@(ViewData.ModelState["NewEmail"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="NewEmail"></label>
	<input class="form-input @(ViewData.ModelState["NewEmail"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="NewEmail" placeholder="@Html.DisplayNameFor(m => m.NewEmail)" />
	<span class="invalid-validation-message" asp-validation-for="NewEmail"></span>
	<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
	<input class="btn btn-primary" type="submit" value="Add" />
</form>
@section Scripts {
	<script src="~/js/form.js"></script>
}