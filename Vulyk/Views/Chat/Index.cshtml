@model Vulyk.ViewModels.ChatListViewModel
@{
	Layout = "~/Views/Shared/AppLayout.cshtml";
	ViewData["Title"] = "Chats";
}
@section Styles {
	<link rel="stylesheet" href="~/css/ChatPage.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/form.css" asp-append-version="true" />
}
@{
	bool noChats = Model.ChatItems.Count() == 0 && Model.NewUserId == null;
}
@if (noChats)
{
	<div class="flex-column gap-2" id="no-chats">
		<div class="subtitle secondary-text">You don't have any chats yet.</div>
		<a class="btn btn-primary" asp-controller="Chat" asp-action="Create">Add chat</a>
	</div>
}
<div class="chat-page-container @(noChats ? "d-none" : "d-flex")">
	<div class="chat-panel chat-panel-visible">
		@foreach (ChatListItemViewModel chatItemViewModel in Model.ChatItems)
		{
			<div class="chat-item" data-chat-id="@chatItemViewModel.ChatId" data-user-id="@chatItemViewModel.UserId">
				<div class="d-flex">
					<div class="chat-title overflow-text">@chatItemViewModel.FullName</div>
					<div class="last-message-data-time">@chatItemViewModel.GetLastMessageDateForChat()</div>
				</div>

				<div class="chat-last-message overflow-text">@chatItemViewModel.LastMessageText</div>
			</div>
		}
	</div>

	<div id="messages" class="message-panel @(ViewData["SidepanelVisibility"] as bool? == true ? "opacity-50" : string.Empty)">
		@if (Model.NewUserId == null && Model.DisplayChatId == null)
		{
			<div class="h-100" id="no-selected-chat">
				<div class="subtitle secondary-text">Select chat to start messaging</div>
			</div>
		}
	</div>

</div>
<div id="chat-launcher"
	 data-your-user-id="@Model.UserId"
	 data-your-name="@Model.FullName"
	 data-user-to-add-id="@Model.NewUserId"
	 data-chat-id="@Model.DisplayChatId"
	 data-chat-ids='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChatItems.Select(c => c.ChatId.ToString()).ToList()))'>
</div>
@section Scripts {
	<script src="~/lib/signalr/signalr.min.js"></script>
	<script src="~/js/chat.js"></script>
}
