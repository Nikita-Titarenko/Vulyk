@using Vulyk.ViewModels
@model NameAndPasswordInputViewModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Registration";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h5 class="subheading bold-text">Welcome to Vulyk</h5>
<h6 class="subtitle w-75 text-center">Enter your fullName and password to create an account</h6>
<form class="form" asp-controller="Account" asp-action="NameAndPasswordInput">
	<input asp-for="Email" type="hidden" />
	<label class="@(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="FullName"></label>
	<input class="form-input @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="FullName" placeholder="FullName" />
	<span class="invalid-validation-message" asp-validation-for="FullName"></span>
	<div class="password-wrapper">
		<input class="form-input password-input w-100 @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="Password" placeholder="Password" />
		<button class="btn-show-password" type="button">
			<i class="fa fa-eye-slash eye-icon"></i>
		</button>
	</div>
	<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
	<input class="btn btn-primary" type="submit" value="Sign up" />
</form>
@section Scripts {
	<script src="~/js/form.js"></script>
}