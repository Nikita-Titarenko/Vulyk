@using Vulyk.ViewModels
@model VerificationCodeConfirmViewModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Registration";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h5 class="subheading bold-text">Welcome to Vulyk</h5>
<h6 class="subtitle w-75 text-center">Create an account</h6>
<form class="form" asp-controller="Account" asp-action="VerificationCodeConfirm">
	<input asp-for="Email" type="hidden" />
	<label class="@(ViewData.ModelState["VerificationCode"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="VerificationCode"></label>
	<input class="form-input @(ViewData.ModelState["VerificationCode"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="VerificationCode" placeholder="VerificationCode" />
	<span class="invalid-validation-message" asp-validation-for="VerificationCode"></span>
	<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
	<input class="btn btn-primary" type="submit" value="Sign up" />
</form>