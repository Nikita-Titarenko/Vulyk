@model EmailInputViewModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Password reset";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h5 class="subheading bold-text">Password reset</h5>
<h6 class="subtitle w-75 text-center">Enter email and we will send you a link to change password</h6>
<form class="form" asp-controller="Account" asp-action="@nameof(AccountController.ForgotPassword)">
	<label class="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "label-validation-error" : "")" asp-for="Email"></label>
	<input class="form-input @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "input-validation-error" : "")" asp-for="Email" placeholder="@Html.DisplayNameFor(m => m.Email)" />
	<span class="invalid-validation-message" asp-validation-for="Email"></span>
	<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
	<input class="btn btn-primary" type="submit" value="Send" />
</form>
@section Scripts {
	<script src="~/js/form.js"></script>
}