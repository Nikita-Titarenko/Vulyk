@model VerifyEmailViewModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Verify Email";
	string display = Model.EmailConfirmation == Vulyk.Services.UserService.EmailConfirmation.ConfirmCurrentEmail ? "d-none" : "";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h5 class="subheading bold-text">Verification</h5>
<h6 class="subtitle w-75 text-center">Open the link that was sent to @Model.Email to verify your email</h6>
@if (Model.TokenIncorrect != null && Model.TokenIncorrect == true)
{
	<div class="invalid-validation-message">Your email could not be verified.</div>
}

<div class="mx-auto">
	<form method="post" asp-action="@nameof(AccountController.SendVerificationToken)" asp-controller="Account">
		<input type="hidden" asp-for="Email" />
		<input type="hidden" asp-for="EmailConfirmation" />
		<input type="hidden" asp-for="Token" />
		<input type="hidden" asp-for="ReturnUrl" />
		<input class="link" type="submit" value="Send link again" />
		<span class="@display"> or </span>
	</form>

	<a class="@display link w-100 d-flex justify-content-center"
	   asp-action="@nameof(AccountController.InputWrongEmail)"
	   asp-controller="Account" asp-route-token="@Model.Token"
	   asp-route-returnUrl="@Model.ReturnUrl"
	   asp-route-emailConfirmation="@Model.EmailConfirmation"
	   asp-route-token="@Model.Token">
		change email
	</a>
</div>