@model EmailViewModel
@{
	Layout = "~/Views/Shared/AuthLayout.cshtml";
	ViewData["Title"] = "Registration";
}
@section Styles {
	<link rel="stylesheet" href="~/css/form.css" />
}
<h5 class="subheading bold-text">Verification</h5>
<h6 class="subtitle w-75 text-center">Open the link that was sent to @Model.Email to verify your email</h6>
<form class="form" asp-controller="Account">
	<div class="invalid-validation-message" asp-validation-summary="ModelOnly"></div>
</form>