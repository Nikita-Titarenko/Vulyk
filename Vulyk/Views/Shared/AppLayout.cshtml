<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Vulyk</title>
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Tiro+Devanagari+Hindi&Roboto">
</head>
<body>
	<button class="navbar-toggler-custom">
		<i class="fa fa-bars"></i>
	</button>
	<div class="app">
		<div class="sidebar @(ViewData["SidepanelVisibility"] as bool? == true ? "sidebar-visible" : "sidebar-invisible")">
			<div class="navbar h-100">
				<ul class="navbar-nav h-100">
					<li class="nav-item">
						<a class="nav-link" asp-action="@nameof(ChatController.Index)" asp-controller="Chat">
							<i class="i-nav fa fa-comment @(ViewData["ChoosedPage"] as string == "Chats" ? "i-choosed" : "")"></i>
						</a>
					</li>
					<li>
						<a class="nav-link" asp-action="@nameof(ChatController.Create)" asp-controller="Chat">
							<i class="i-nav fa fa-plus @(ViewData["ChoosedPage"] as string == "CreateChat" ? "i-choosed" : "")"></i>
						</a>
					</li>
					<li>
						<a class="nav-link" asp-action="@nameof(ProfileController.EditProfile)" asp-controller="Profile">
							<i class="i-nav fa fa-user-circle-o @(ViewData["ChoosedPage"] as string == "EditProfile" ? "i-choosed" : "")"></i>
						</a>
					</li>
					<li class="mt-auto">
						<form asp-action="@nameof(AccountController.LogOut)" asp-controller="Account">
							<button class="nav-link" type="submit">
								<i class="i-nav fa fa-sign-out"></i>
							</button>
						</form>
					</li>
				</ul>
			</div>
		</div>
		<main role="main">
			@RenderBody()
		</main>
	</div>
	@await RenderSectionAsync("Styles", required: false)
	<script src="~/js/app.js"></script>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>