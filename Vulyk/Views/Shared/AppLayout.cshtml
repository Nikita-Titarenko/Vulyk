<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Vulyk</title>
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Tiro+Devanagari+Hindi&Roboto">
</head>
<body>
	<header>
		<div class="navbar h-100">
			<ul class="navbar-nav h-100">
				<li class="nav-item">
					<a class="nav-link" asp-action="Index" asp-controller="Chat">
						<i class="fa fa-comment @(ViewData["ChoosedPage"] as string == "Chats" ? "i-choosed" : "")"></i>
					</a>
				</li>
				<li>
					<a class="nav-link" asp-action="Create" asp-controller="Chat">
						<i class="fa fa-plus @(ViewData["ChoosedPage"] as string == "CreateChat" ? "i-choosed" : "")"></i>
					</a>
				</li>
				<li>
					<a class="nav-link" asp-action="EditProfile" asp-controller="Profile">
						<i class="fa fa-user-circle-o @(ViewData["ChoosedPage"] as string == "EditProfile" ? "i-choosed" : "")"></i>
					</a>
				</li>
				<li class="mt-auto">
					<form asp-action="LogOut" asp-controller="Account">
						<button class="nav-link" type="submit">
							<i class="fa fa-sign-out"></i>
						</button>
					</form>
				</li>
			</ul>
		</div>
	</header>
	<main role="main">
		@RenderBody()
	</main>
	@await RenderSectionAsync("Styles", required: false)
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>